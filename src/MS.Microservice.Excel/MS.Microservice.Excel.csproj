<Project>
  <!-- Set paths before SDK imports so restore/build outputs of each variant remain independent. -->
  <PropertyGroup>
    <ExcelVariant Condition="'$(ExcelVariant)' == ''">All</ExcelVariant>
    <BaseIntermediateOutputPath>obj/$(ExcelVariant)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(ExcelVariant)/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName Condition="'$(ExcelVariant)' == 'Aot'">MS.Microservice.Excel.Aot</AssemblyName>
    <PackageId Condition="'$(ExcelVariant)' == 'Aot'">MS.Microservice.Excel.Aot</PackageId>
    <EnableOfficeDiagnostics Condition="'$(EnableOfficeDiagnostics)' == ''">false</EnableOfficeDiagnostics>
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ExcelVariant)' == 'Generator'">
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>MS.Microservice.Excel.Generator</AssemblyName>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableOfficeDiagnostics)' == 'true'">
    <DefineConstants>$(DefineConstants);MS_Microservice_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MS.Microservice.Excel.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="**/*.cs" Condition="'$(ExcelVariant)' == 'Aot' or '$(ExcelVariant)' == 'Generator'" />
    <Compile Include="../MS.Microservice.Excel.Aot/**/*.cs" Exclude="../MS.Microservice.Excel.Aot/Generator/**/*.cs" Condition="'$(ExcelVariant)' == 'All' or '$(ExcelVariant)' == 'Aot'" Link="MS.Microservice.Excel.Aot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(ExcelVariant)' == 'Generator'">
    <Compile Include="../MS.Microservice.Excel.Aot/Generator/*.cs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <AdditionalFiles Include="../MS.Microservice.Excel.Aot/Generator/AnalyzerReleases.*.md" />
  </ItemGroup>
  <ItemGroup Condition="'$(ExcelVariant)' != 'Generator'">
    <PackageReference Include="MiniExcel" Condition="'$(ExcelVariant)' != 'Aot'" />
    <PackageReference Include="NPOI" />
  </ItemGroup>
  <ItemGroup Condition="'$(ExcelVariant)' == 'Aot'">
    <None Include="bin/Generator/$(Configuration)/netstandard2.0/MS.Microservice.Excel.Generator.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <ItemGroup>
    <ExcelGeneratorSource Include="../MS.Microservice.Excel.Aot/Generator/*" />
  </ItemGroup>
  <Target Name="BuildExcelGenerator" BeforeTargets="CoreCompile"
          Inputs="@(ExcelGeneratorSource);$(MSBuildProjectFullPath);$(MSBuildProjectDirectory)/../../Directory.Packages.props;$(MSBuildProjectDirectory)/../../Directory.Build.props;$(MSBuildProjectDirectory)/../../global.json"
          Outputs="$(MSBuildProjectDirectory)/bin/Generator/$(Configuration)/netstandard2.0/MS.Microservice.Excel.Generator.dll" Condition="'$(ExcelVariant)' == 'All' or '$(ExcelVariant)' == 'Aot'">
    <Exec Command="dotnet build &quot;$(MSBuildProjectFullPath)&quot; -p:ExcelVariant=Generator -c $(Configuration) -p:RestorePackagesPath=&quot;$(NuGetPackageRoot)/&quot; -p:NuGetAudit=$(NuGetAudit) --verbosity quiet" />
  </Target>
  <Target Name="ValidateExcelVariant" BeforeTargets="PrepareForBuild;CollectPackageReferences">
    <Error Condition="'$(ExcelVariant)' != 'All' and '$(ExcelVariant)' != 'Legacy' and '$(ExcelVariant)' != 'Aot' and '$(ExcelVariant)' != 'Generator'"
           Text="ExcelVariant must be All, Legacy, Aot or Generator." />
  </Target>
  <Target Name="RequireExcelPackageVariant" BeforeTargets="GenerateNuspec" Condition="'$(ExcelVariant)' == 'All'">
    <Error Text="Choose -p:ExcelVariant=Legacy or -p:ExcelVariant=Aot when packing Excel." />
  </Target>
</Project>
