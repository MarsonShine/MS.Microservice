{
  "realm": "ms-reference",
  "enabled": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "ms-reference-ops",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${MS_REFERENCE_OPS_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["reference-audience", "profiles.manage", "messaging.manage"]
    },
    {
      "clientId": "ms-reference-reader",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${MS_REFERENCE_READER_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["reference-audience"]
    }
  ],
  "clientScopes": [
    {
      "name": "reference-audience",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "reference-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "ms-reference", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "name": "profiles.manage",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "messaging.manage",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    }
  ]
}
